# The ONLY difference between local and production is this connection string.
#
# Local development (embedded PGlite, no Docker, no server):
DATABASE_URL="file:./.pglite"
#
# Hosted (any Postgres that speaks the wire protocol — Neon is what this was
# built against). The Neon driver is used over WebSockets, not HTTP, because an
# interactive transaction is required:
# DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/kriaturas?sslmode=require"

# Opens the "Entrar al panel" door on /entrar, which hands out the SEEDED ADMIN
# session to whoever clicks it. There is no login yet, so this is the only way
# to reach /admin from a phone — and it is off unless it is set, because a
# public link that gives away the admin panel should never be a default.
# ALLOW_ADMIN_ENTRY="true"

# IMAGES. All three or none: the local disk adapter is used when they are
# missing, which is right for a laptop and impossible on a hosted server (no
# writable filesystem). The API key is public; the SECRET is not — it belongs in
# the host's environment variables and nowhere else, never in the repo.
# CLOUDINARY_CLOUD_NAME="tu-cloud-name"
# CLOUDINARY_API_KEY="254579537742669"
# CLOUDINARY_API_SECRET="..."
# CLOUDINARY_FOLDER="kriaturas"
